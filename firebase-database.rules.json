{
  "rules": {
    "users": {
      ".read": "auth != null && (auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",

      ".write": "auth != null && (auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && newData.val() === null) || auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "userProgress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "adminLogs": {
      ".read": "auth != null && (auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",

      ".write": "auth != null && (auth.token.email === 'delahozbarcelojunior@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "tecnomath": {
      "evento": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
