rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin principal: custom claim. Fallback compatible con las cuentas
    // administrativas oficiales mientras el claim se propaga.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'delahozbarcelojunior@gmail.com'
        || request.auth.token.email == 'nicolenatera26@gmail.com'
        || request.auth.token.email == 'mateobarbosamatos@gmail.com'
        || request.auth.token.email == 'jandresvf23@gmail.com'
      );
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid;
        allow update: if signedIn() && (uid == request.auth.uid || isAdmin());
        allow delete: if signedIn() && (uid == request.auth.uid || isAdmin());
      }

      match /scores/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid;
        allow update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
      match /games/{gameId}/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
