rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administradores reconocidos por el custom claim o por la lista
    // oficial de correos que ya utiliza TecnoMath. El fallback por correo
    // permite que el panel siga funcionando mientras el claim se propaga.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'delahozbarcelojunior@gmail.com'
        || request.auth.token.email == 'nicolenatera26@gmail.com'
        || request.auth.token.email == 'mateobarbosamatos@gmail.com'
        || request.auth.token.email == 'jandresvf23@gmail.com'
      );
    }

    // =========================
    // TORNEOS
    // =========================
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid;
        allow update: if isAdmin()
          || (signedIn() && uid == request.auth.uid);
        allow delete: if isAdmin()
          || (signedIn() && uid == request.auth.uid);
      }

      // Las puntuaciones normales las escribe la Cloud Function confiable.
      // El admin puede operar sobre ellas para mantenimiento/pruebas.
      match /scores/{uid} {
        allow read: if signedIn();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // =========================
    // RANKING GLOBAL
    // =========================
    match /leaderboards/global/players/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // RANKING POR JUEGO
    // =========================
    match /leaderboards/games/{gameId}/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
