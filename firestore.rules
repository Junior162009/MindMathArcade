rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'delahozbarcelojunior@gmail.com'
        || request.auth.token.email == 'nicolenatera26@gmail.com'
        || request.auth.token.email == 'mateobarbosamatos@gmail.com'
        || request.auth.token.email == 'jandresvf23@gmail.com'
      );
    }
    function isBotId(uid) { return uid.matches('bot_.*'); }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (uid == request.auth.uid && request.resource.data.isBot != true) ||
          (isAdmin() && isBotId(uid) && request.resource.data.isBot == true)
        );
        allow update: if signedIn() && (
          (uid == request.auth.uid && resource.data.isBot != true && request.resource.data.isBot != true) ||
          (isAdmin() && isBotId(uid) && resource.data.isBot == true && request.resource.data.isBot == true)
        );
        allow delete: if signedIn() && (
          (uid == request.auth.uid && resource.data.isBot != true) ||
          (isAdmin() && isBotId(uid) && resource.data.isBot == true)
        );
      }

      match /scores/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (uid == request.auth.uid && request.resource.data.isBot != true) ||
          (isAdmin() && isBotId(uid) && request.resource.data.isBot == true)
        );
        allow update: if signedIn() && (
          (uid == request.auth.uid && resource.data.isBot != true && request.resource.data.isBot != true) ||
          (isAdmin() && isBotId(uid) && resource.data.isBot == true && request.resource.data.isBot == true)
        );
        allow delete: if isAdmin() && isBotId(uid) && resource.data.isBot == true;
      }
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
      match /games/{gameId}/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
