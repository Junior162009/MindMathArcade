rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    // =========================
    // TORNEOS
    // =========================
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid;
        allow update: if isAdmin()
          || (signedIn() && uid == request.auth.uid);
        allow delete: if isAdmin()
          || (signedIn() && uid == request.auth.uid);
      }

      // Scores are written only by the trusted Cloud Function.
      // Players can read their rankings, but cannot forge or edit scores.
      match /scores/{uid} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // =========================
    // RANKING GLOBAL
    // /leaderboards/global/players/{uid}
    // =========================
    // Written only by recordCompetitionScore in Cloud Functions.
    match /leaderboards/global/players/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // RANKING POR JUEGO
    // /leaderboards/games/{gameId}/{uid}
    // =========================
    // Written only by recordCompetitionScore in Cloud Functions.
    match /leaderboards/games/{gameId}/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
