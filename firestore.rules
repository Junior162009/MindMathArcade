rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'delahozbarcelojunior@gmail.com'
        || request.auth.token.email == 'nicolenatera26@gmail.com'
        || request.auth.token.email == 'mateobarbosamatos@gmail.com'
        || request.auth.token.email == 'jandresvf23@gmail.com'
      );
    }

    // El acceso especial del tester se limita estrictamente a documentos
    // identificados como bots. No concede permisos adicionales sobre usuarios.
    function isBotId(uid) {
      return uid.matches('bot_[A-Za-z0-9_-]+');
    }

    function isBotData() {
      return request.resource.data.isBot == true
        && request.resource.data.botId is string
        && isBotId(request.resource.data.botId);
    }

    function existingBotData() {
      return resource.data.isBot == true
        && resource.data.botId is string
        && isBotId(resource.data.botId);
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{uid} {
        allow read: if signedIn();

        // Usuario normal: solamente su propio documento.
        allow create: if signedIn() && uid == request.auth.uid
          || (isAdmin() && isBotId(uid) && isBotData());

        allow update: if signedIn() && uid == request.auth.uid
          || (isAdmin() && isBotId(uid) && existingBotData() && isBotData());

        allow delete: if signedIn() && uid == request.auth.uid
          || (isAdmin() && isBotId(uid) && existingBotData());
      }

      match /scores/{uid} {
        allow read: if signedIn();

        // Usuario normal: solamente su propio score.
        // Tester: solamente scores sintéticos de bots.
        allow create: if signedIn() && uid == request.auth.uid
          || (isAdmin() && isBotId(uid) && isBotData());

        allow update: if signedIn() && uid == request.auth.uid
          || (isAdmin() && isBotId(uid) && existingBotData() && isBotData());

        allow delete: if isAdmin() && isBotId(uid) && existingBotData();
      }
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
      match /games/{gameId}/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
